# Private payout-process environment. Never give this file to the public viewer.
# Do not reuse the Fly signing wallet or the Operations recipient as payout wallet.
CLAIMS_MODE=PAYOUT_WALLET
PAYOUT_EXECUTION_ENABLED=NO
PROJECT_TOKEN_ADDRESS=
PROJECT_TOKEN_DEPLOYMENT_BLOCK=
PROJECT_TOKEN_DECIMALS=
ELIGIBILITY_EXCLUDED_ADDRESSES=
HOLDER_SOURCE=REAL_HOLDERS
BAG_ROOM_ORIGIN=http://localhost:8799
BAG_ROUND_SECONDS=30
BAG_PROFIT_TO_VAULT_BPS=10000
FLY_WALLET_ADDRESS=
HOLDER_PAYOUT_WALLET_ADDRESS=
CLAIM_WINDOW_DAYS=30
# FLY or OPERATIONS, explicitly selected. Gas never reduces holder allocations.
PAYOUT_GAS_SPONSOR=UNCONFIGURED
PAYOUT_MAX_TRANSFER_WEI=
PAYOUT_MAX_TOTAL_OUTGOING_WEI=
PAYOUT_MAX_GAS_PRICE_WEI=
PAYOUT_MAX_GAS_PER_TX=
PAYOUT_KEYSTORE_FILE=
PAYOUT_KEYSTORE_PASSWORD_FILE=
